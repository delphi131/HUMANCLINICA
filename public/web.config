<?xml version="1.0" encoding="UTF-8"?>
<!--
  Committed to the repo on purpose: without this file, the *.php handler
  mapping (and the "allow .php" request-filtering rule) only exist as
  server-side IIS config written into a web.config that IIS itself creates
  in this folder — and since that file isn't tracked in git, every deploy's
  "robocopy /MIR" (which mirrors the destination to exactly match the repo)
  deletes it, silently breaking PHP execution until it's reconfigured by
  hand in IIS Manager again.

  Adjust the scriptProcessor path below if PHP is installed somewhere other
  than C:\php on the server.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="PHP via FastCGI" path="*.php" verb="*" modules="FastCgiModule" scriptProcessor="C:\php\php-cgi.exe" resourceType="Either" />
    </handlers>
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".php" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <defaultDocument>
      <files>
        <clear />
        <add value="login.php" />
        <add value="index.php" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
